rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/partecipanti/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApprovato() {
      let d = get(/databases/$(database)/documents/partecipanti/$(request.auth.uid)).data;
      return isAuth() && d.approvato == true && d.get('disabilitato', false) != true;
    }

    // ── PARTECIPANTI ──────────────────────────────────
    match /partecipanti/{uid} {
      // Lettura: ognuno può leggere il proprio profilo; gli admin leggono tutti.
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());

      // Creazione: un utente autenticato può creare SOLO il proprio documento,
      // con approvato: false obbligatorio (non può auto-approvarsi).
      allow create: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.approvato == false
        && request.resource.data.isAdmin == false;

      // Aggiornamento: solo admin (approvazione, correzioni, promozione ad
      // admin di altri membri). Un utente con isOwner:true può essere
      // modificato SOLO da se stesso, così nessun altro admin può revocargli
      // i privilegi; e il flag isOwner non è modificabile dal client da
      // nessuno (si assegna solo con set-owner.js / Admin SDK).
      allow update: if isAdmin()
        && (!resource.data.get('isOwner', false) || request.auth.uid == uid)
        && request.resource.data.get('isOwner', false) == resource.data.get('isOwner', false);

      // Cancellazione: solo admin (rifiuto richieste).
      allow delete: if isAdmin();
    }

    // ── PRONOSTICI ────────────────────────────────────
    // Fase 1 (fase a campionato): segni + risultati esatti per giornata,
    // bonus una tantum. L'apertura/chiusura è PER GIORNATA (campo
    // risultati/ufficiali.giornate[i].aperta) ed è gestita lato client
    // (aggiornato 2026-09-05: rimosso l'interruttore generale
    // sistema/config.pronostici_aperti). Le rules non possono verificare
    // "quali giornate tocca questa scrittura" senza logica complessa sugli
    // array, quindi qui si controlla solo identità e approvazione.
    match /pronostici/{uid} {
      allow read:  if isApprovato();
      allow write: if (isApprovato() && request.auth.uid == uid) || isAdmin();
    }

    // ── RISULTATI ─────────────────────────────────────
    // risultati/ufficiali: segni reali partita per partita, classifica reale
    // derivata, bonus fine-fase reali, flag "congelata" (classifica finale
    // definitiva, sblocca il punteggio fascia/posizione esatta).
    match /risultati/{doc} {
      allow read: if isApprovato();
      allow write: if isAdmin();
    }

    // ── CLASSIFICA (utenti, calcolata) ────────────────
    match /classifica/{doc} {
      allow read: if isApprovato();
      allow write: if isAdmin(); // scritta dalla Cloud Function (Admin SDK bypassa comunque)
    }

    // ── SISTEMA / CONFIG ──────────────────────────────
    match /sistema/{doc} {
      allow read:  if isAuth(); // anche non approvati, serve per sapere se aperti
      allow write: if isAdmin();
    }
  }
}
