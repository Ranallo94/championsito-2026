rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/partecipanti/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApprovato() {
      let d = get(/databases/$(database)/documents/partecipanti/$(request.auth.uid)).data;
      return isAuth() && d.approvato == true && d.get('disabilitato', false) != true;
    }

    // ── PARTECIPANTI ──────────────────────────────────
    match /partecipanti/{uid} {
      // Lettura: ognuno può leggere il proprio profilo; gli admin leggono tutti.
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());

      // Creazione: un utente autenticato può creare SOLO il proprio documento,
      // con approvato: false obbligatorio (non può auto-approvarsi).
      allow create: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.approvato == false
        && request.resource.data.isAdmin == false;

      // Aggiornamento: solo admin (approvazione, correzioni). Un utente con
      // isOwner:true può essere modificato SOLO da se stesso, così nessun altro
      // admin può revocargli i privilegi.
      allow update: if isAdmin() && (
        !resource.data.get('isOwner', false) ||
        request.auth.uid == uid
      );

      // Cancellazione: solo admin (rifiuto richieste).
      allow delete: if isAdmin();
    }

    // ── PRONOSTICI ────────────────────────────────────
    // Fase 1 (fase a campionato): segni 1X2 per giornata + classifica finale
    // prevista + bonus una tantum. Un solo lock per tutta la scheda: si chiude
    // all'inizio della prima giornata (niente lock differenziato per giornata,
    // per evitare che un utente aggiusti il pronostico di giornata 3 dopo aver
    // visto l'esito di giornata 1 — semplice e conservativo).
    function pronosticiAperti() {
      let cfg = exists(/databases/$(database)/documents/sistema/config)
        ? get(/databases/$(database)/documents/sistema/config).data : {};
      return (!exists(/databases/$(database)/documents/sistema/config)) ||
        (cfg.get('pronostici_aperti', true) == true);
    }
    match /pronostici/{uid} {
      allow read:  if isApprovato();
      allow write: if (isApprovato() && request.auth.uid == uid && pronosticiAperti()) || isAdmin();
    }

    // ── RISULTATI ─────────────────────────────────────
    // risultati/ufficiali: segni reali partita per partita, classifica reale
    // derivata, bonus fine-fase reali, flag "congelata" (classifica finale
    // definitiva, sblocca il punteggio fascia/posizione esatta).
    match /risultati/{doc} {
      allow read: if isApprovato();
      allow write: if isAdmin();
    }

    // ── CLASSIFICA (utenti, calcolata) ────────────────
    match /classifica/{doc} {
      allow read: if isApprovato();
      allow write: if isAdmin(); // scritta dalla Cloud Function (Admin SDK bypassa comunque)
    }

    // ── SISTEMA / CONFIG ──────────────────────────────
    match /sistema/{doc} {
      allow read:  if isAuth(); // anche non approvati, serve per sapere se aperti
      allow write: if isAdmin();
    }
  }
}
